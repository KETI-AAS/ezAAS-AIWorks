PORT=8002
DATABASE_URL=postgresql://ezai:password@postgres:5432/ezai
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── mapping ──
SEMANTIC_MAPPING_DATA_DIR=./data

# 후보 검색
DEFAULT_TOP_K=5
MIN_SIMILARITY=0.05

# 임베딩: hashing(기본, 오프라인) | sentence_transformers | openai
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=

# 컬럼명·약어 해석기: rule_based(기본) | openai
INTERPRETER_BACKEND=rule_based
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# 지식그래프: memory(기본) | neo4j
KG_BACKEND=memory
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 추가 의미사전(JSON, 콤마 구분) — ECLASS/IEC CDD/AAS CD 에서 추출한 기관 사전
SEMANTIC_DICTIONARY_PATH=

# AAS 근거로 확보된 경우 '필수 조건'으로 취급할 속성
REQUIRED_ATTRS=concept,quantity,unit,data_type,measurement_location,value_representation
PREVIEW_ROWS=5
ALLOW_NUMERIC_STRING_CAST=true
