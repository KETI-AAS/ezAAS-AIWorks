PORT=8001
DATABASE_URL=postgresql://ezai:password@postgres:5432/ezai
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
AASX_STORAGE_DIR=data/aasx
MAX_AASX_UPLOAD_BYTES=104857600

# Opt-in Hub SSO prototype (single process, no DB)
CAPABILITY_SSO_ENABLED=false
HUB_SSO_BASE_URL=http://localhost:8000
CAPABILITY_SSO_CALLBACK_URL=http://localhost:8001/auth/hub/callback
CAPABILITY_SSO_CLIENT_ID=capability
CAPABILITY_SSO_CLIENT_SECRET=CHANGE_ME_SHARED_SERVER_SECRET_AT_LEAST_32_CHARACTERS
CAPABILITY_SSO_ALLOW_LOCAL_HTTP=true
CAPABILITY_SSO_COOKIE_SECURE=false
CAPABILITY_SSO_SESSION_SECONDS=3600
